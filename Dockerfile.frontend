# ==============================================================================
# DataPulse AI — Frontend Dockerfile (Nginx Reverse Proxy & Static SPA)
# ==============================================================================

FROM nginx:alpine

# Remove default Nginx welcome assets
RUN rm -rf /usr/share/nginx/html/*

# Copy static frontend application assets
COPY ai_agent/frontend/index.html /usr/share/nginx/html/
COPY ai_agent/frontend/script.js  /usr/share/nginx/html/
COPY ai_agent/frontend/style.css  /usr/share/nginx/html/

# Copy custom Nginx configuration with /api/ reverse proxy
COPY ai_agent/frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check to verify Nginx is actively serving index.html
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1/ || exit 1

# Launch Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
