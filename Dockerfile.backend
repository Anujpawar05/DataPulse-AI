# ==============================================================================
# DataPulse AI — Backend Dockerfile (FastAPI & Analytics Engine)
# ==============================================================================

FROM python:3.12-slim

# Prevent Python from writing bytecode and enable unbuffered standard I/O
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8001

WORKDIR /app

# Install curl for container health checks and clean up apt cache
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies from root requirements.txt
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

# Create non-root application user and group
RUN groupadd -g 1000 appuser \
    && useradd -u 1000 -g appuser -m -s /bin/bash appuser

# Copy application source code (excluding files defined in .dockerignore)
COPY ai_agent/ ./ai_agent/

# Ensure SQLite data directory exists and assign ownership to appuser
RUN mkdir -p /app/ai_agent/backend/data \
    && chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose backend service port
EXPOSE 8001

# Container health check against FastAPI /health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8001/health || exit 1

# Launch FastAPI backend via Uvicorn
CMD ["uvicorn", "ai_agent.backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
